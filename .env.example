# Copy this file to .env, fill the required values, then run:
#   set -a; source .env; set +a

# Required: OCI CLI config. Keep defaults if you already use DEFAULT.
OCI_CONFIG_FILE="$HOME/.oci/config"
OCI_CONFIG_PROFILE="DEFAULT"
# Optional: set only when your OCI private key has a passphrase.
OCI_PRIVATE_KEY_PASSWORD=""

# Optional: set to ./main.tf when using a Terraform file generated by OCI Resource Manager.
# Values below can be omitted when main.tf contains them.
ORACLE_ARM_TF_FILE=""

# Required option B: manually configure these when not using main.tf,
# or use them to override values parsed from main.tf.
ORACLE_ARM_COMPARTMENT_ID=""
ORACLE_ARM_AVAILABILITY_DOMAIN=""
ORACLE_ARM_SUBNET_ID=""
ORACLE_ARM_DISPLAY_NAME=""
ORACLE_ARM_IMAGE_ID=""
ORACLE_ARM_OCPUS="1"
ORACLE_ARM_MEMORY_GBS="6"

# Optional instance settings.
ORACLE_ARM_BOOT_VOLUME_GBS="50"
ORACLE_ARM_SHAPE="VM.Standard.A1.Flex"
ORACLE_ARM_ASSIGN_PUBLIC_IP="true"
ORACLE_ARM_PV_ENCRYPTION="true"

# Optional login settings. If root password is disabled, SSH key is required.
ORACLE_ARM_ENABLE_ROOT_PASSWORD="true"
ORACLE_ARM_ROOT_PASSWORD=""
ORACLE_ARM_SSH_AUTHORIZED_KEYS=""

# Optional retry and public IP lookup settings, in seconds.
ORACLE_ARM_INITIAL_SLEEP_SECONDS="5"
ORACLE_ARM_MIN_SLEEP_SECONDS="5"
ORACLE_ARM_MAX_SLEEP_SECONDS="60"
ORACLE_ARM_PUBLIC_IP_WAIT_SECONDS="600"
ORACLE_ARM_PUBLIC_IP_INTERVAL_SECONDS="5"

# Optional Telegram push. Leave TG_ENABLED=false to disable.
TG_ENABLED="false"
TG_BOT_TOKEN=""
TG_CHAT_ID=""
TG_API_HOST="api.telegram.org"
